---
import '../styles/global.css';
import { SITE, canonical } from '../config';
import Analytics from '@vercel/analytics/astro';

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  type = 'website',
  articleDate,
  modifiedDate,
  category,
  jsonLd,
  robots = 'index,follow',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | Practical finance, investing & technology`;
const url = canonical(path);
const ogImage = canonical('/og-default.png');
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const adsConsentConfigured = import.meta.env.PUBLIC_ADS_CONSENT_CONFIGURED === 'true';
const showAds = /^ca-pub-\d+$/.test(adClient) && adsConsentConfigured;
const organization = {
  '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name,
  url: `${SITE.url}/`, logo: { '@type':'ImageObject', url: canonical('/techmintai-logo.webp') },
};
const website = {
  '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name,
  url: `${SITE.url}/`, description: SITE.description,
  publisher: {'@id': `${SITE.url}/#organization`}, inLanguage: 'en',
};
const webpage = {
  '@type': 'WebPage', '@id': `${url}#webpage`, url, name: pageTitle,
  description, isPartOf: {'@id': `${SITE.url}/#website`}, inLanguage:'en',
};
const additional = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const graph = [organization, website, webpage, ...additional.map(item => {
  const {'@context': _context, ...node} = item;
  return node;
})];
const serializedSchema = JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en" data-ga4-id={/^G-[A-Z0-9]+$/.test(ga4Id) ? ga4Id : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f8f5" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="TechMintAI RSS feed" href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="TechMintAI — clear thinking on finance and technology" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {type === 'article' && articleDate && <meta property="article:published_time" content={articleDate} />}
    {type === 'article' && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {type === 'article' && category && <meta property="article:section" content={category} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={serializedSchema} />
    {showAds && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="masthead-strip">
        <div class="container masthead-strip-inner">
          <span>THE FINANCE & TECHNOLOGY JOURNAL</span>
          <span>Independent explainers · Free financial tools</span>
        </div>
      </div>
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="TechMintAI — homepage"><span>TechMint</span><span class="wordmark-ai">AI</span><span class="wordmark-period">.</span></a>
        <p class="header-tagline">Make sense of money.<br />Understand the technology.</p>
        <a href="/search/" class="header-search" aria-label="Search TechMintAI"><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.9"/><path d="m16 16 5 5"/></svg><span>Search</span></a>
      </div>
      <div class="nav-rule">
        <div class="container nav-inner">
          <nav class="primary-nav" aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/category/finance/">Personal Finance</a>
            <a href="/category/investing/">Investing</a>
            <a href="/category/fintech/">Fintech</a>
            <a href="/category/ai/">AI</a>
            <a href="/category/technology/">Technology</a>
            <a href="/category/software/">Software</a>
            <a href="/tools/">Calculators</a>
          </nav>
          <details class="mobile-menu">
            <summary aria-label="Open navigation menu">Sections <span aria-hidden="true">☰</span></summary>
            <nav class="mobile-links" aria-label="Mobile navigation">
              <a href="/">Home</a><a href="/guides/">All guides</a><a href="/category/finance/">Personal Finance</a>
              <a href="/category/investing/">Investing</a><a href="/category/fintech/">Fintech</a>
              <a href="/category/ai/">AI</a><a href="/category/technology/">Technology</a>
              <a href="/category/software/">Software</a><a href="/tools/">Calculators</a>
              <a href="/search/">Search</a>
            </nav>
          </details>
          <a class="nav-side" href="/guides/">All guides ↗</a>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="wordmark" aria-label="TechMintAI homepage"><span>TechMint</span><span class="wordmark-ai">AI</span><span class="wordmark-period">.</span></a>
            <p>Independent explanations of everyday money decisions, digital finance and useful technology.</p>
            <p class="footer-note">Educational information only. We do not give individualized financial advice.</p>
          </div>
          <div>
            <div class="footer-title">Explore</div>
            <nav class="footer-links" aria-label="Explore"><a href="/guides/">All guides</a><a href="/category/finance/">Personal Finance</a><a href="/category/investing/">Investing</a><a href="/category/fintech/">Fintech</a><a href="/category/ai/">AI</a><a href="/category/technology/">Technology</a><a href="/category/software/">Software</a><a href="/tools/">Calculators</a><a href="/rss.xml">RSS feed</a></nav>
          </div>
          <div>
            <div class="footer-title">The publication</div>
            <nav class="footer-links" aria-label="Site policies"><a href="/about/">About us</a><a href="/contact/">Contact</a><a href="/editorial-policy/">Editorial standards</a><a href="/privacy/">Privacy policy</a><a href="/affiliate-disclosure/">How we earn</a><a href="/financial-disclaimer/">Financial disclaimer</a><a href="/terms/">Terms</a><a href="/search/">Search</a></nav>
          </div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} TechMintAI. All rights reserved.</span><span>Made for curious readers, not trading signals.</span></div>
      </div>
    </footer>
    {/^G-[A-Z0-9]+$/.test(ga4Id) && <>
      <div class="cookie-banner" id="analytics-consent" hidden><strong>Optional analytics</strong><p>We only load analytics if you choose to allow it. <a href="/privacy/">Read our privacy policy.</a></p><div class="cookie-actions"><button type="button" class="accept" data-consent="accept">Allow analytics</button><button type="button" class="decline" data-consent="decline">Not now</button></div></div>
      <script src="/js/consent.js" defer></script>
    </>}
    <Analytics />
  </body>
</html>
