---
import '../styles/global.css';
import { SITE, canonical } from '../config';
const {title,description=SITE.description,path=Astro.url.pathname,type='website',articleDate,category,jsonLd,robots='index,follow'} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const url = canonical(path);
const ogImage = canonical('/og-default.png');
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';
const adsConsentConfigured = import.meta.env.PUBLIC_ADS_CONSENT_CONFIGURED === 'true';
const showAds = /^ca-pub-\d+$/.test(adClient) && adsConsentConfigured;
const schema = jsonLd || { '@context':'https://schema.org','@type':'WebPage',name:pageTitle,description,url, isPartOf:{'@type':'WebSite', name:SITE.name,url:SITE.url}};
const serializedSchema=JSON.stringify(schema).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en" data-ga4-id={/^G-[A-Z0-9]+$/.test(ga4Id) ? ga4Id : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102238" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="TechMintAI RSS" href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {type === 'article' && articleDate && <meta property="article:published_time" content={articleDate} />}
    {type === 'article' && category && <meta property="article:section" content={category} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={serializedSchema} />
    {showAds && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="TechMintAI homepage"><img src="/techmintai-logo.webp" alt="TechMintAI" width="169" height="48" decoding="async" /></a>
        <nav class="primary-nav" aria-label="Main navigation">
          <a href="/category/finance/">Finance</a><a href="/category/ai/">AI</a><a href="/category/technology/">Technology</a><a href="/category/fintech/">Fintech</a><a href="/tools/">Tools</a>
        </nav>
        <a href="/search/" class="header-search">Search ↗</a>
        <details class="mobile-menu"><summary aria-label="Open menu">Menu ☰</summary><nav class="mobile-links" aria-label="Mobile navigation"><a href="/">Home</a><a href="/category/finance/">Finance</a><a href="/category/investing/">Investing</a><a href="/category/ai/">AI</a><a href="/category/technology/">Technology</a><a href="/category/fintech/">Fintech</a><a href="/category/software/">Software</a><a href="/tools/">Calculators</a><a href="/search/">Search</a></nav></details>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand"><a class="logo" href="/" aria-label="TechMintAI homepage"><img src="/techmintai-logo.webp" alt="TechMintAI" width="166" height="48" loading="lazy" /></a><p>Clear, practical coverage of money, AI and technology for a global audience.</p></div>
          <div><div class="footer-title">Explore</div><nav class="footer-links" aria-label="Explore"><a href="/category/finance/">Finance</a><a href="/category/investing/">Investing</a><a href="/category/ai/">AI</a><a href="/category/fintech/">Fintech</a><a href="/category/technology/">Technology</a><a href="/category/software/">Software</a><a href="/tools/">Calculators</a><a href="/rss.xml">RSS feed</a></nav></div>
          <div><div class="footer-title">About & trust</div><nav class="footer-links" aria-label="Site policies"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/editorial-policy/">Editorial Policy</a><a href="/privacy/">Privacy</a><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/financial-disclaimer/">Financial Disclaimer</a><a href="/terms/">Terms</a><a href="/search/">Search</a></nav></div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} TechMintAI. All rights reserved.</span><span>Educational content only. Not individualized financial advice.</span></div>
      </div>
    </footer>
    {/^G-[A-Z0-9]+$/.test(ga4Id) && <>
      <div class="cookie-banner" id="analytics-consent" hidden><strong>Optional analytics</strong><p>Help us understand aggregate site usage. Analytics is off until you choose to allow it. <a href="/privacy/" style="text-decoration:underline">Privacy details</a>.</p><div class="cookie-actions"><button type="button" class="accept" data-consent="accept">Allow analytics</button><button type="button" class="decline" data-consent="decline">Not now</button></div></div>
      <script src="/js/consent.js" defer></script>
    </>}
  </body>
</html>
