---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="That page could not be found. Explore TechMintAI's guides and calculators." path="/404/" robots="noindex,nofollow"><div class="container" style="padding:70px 0 100px;text-align:center"><div class="eyebrow">404 / Not found</div><h1 style="font-size:clamp(3rem,9vw,5rem);letter-spacing:-.06em;margin:10px 0">Page not found.</h1><p style="color:var(--muted)">The page may have moved, or the link may be outdated.</p><div class="actions" style="justify-content:center"><a href="/" class="button">Back home</a><a href="/search/" class="button secondary">Search guides</a></div></div></Base>
