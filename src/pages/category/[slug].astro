---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {categories} from '../../config';
import {byCategory} from '../../data/articles';
export function getStaticPaths(){return categories.map(category=>({params:{slug:category.slug},props:{category}}));}
const {category}=Astro.props;
const articles=byCategory(category.slug);
---
<Base title={`${category.name} Guides`} description={category.description} path={`/category/${category.slug}/`}>
  <div class="container"><div class="breadcrumb"><a href="/">Home</a> / {category.name}</div><header class="page-intro"><div class="eyebrow">Explore / {category.name}</div><h1>{category.name} guides</h1><p>{category.description} Every article prioritizes clarity, useful context, and transparent sources.</p></header><section class="section" style="padding-top:10px"><div class="card-grid">{articles.map(article=><ArticleCard article={article}/>)}</div></section></div>
</Base>
