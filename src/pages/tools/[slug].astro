---
import Base from '../../layouts/Base.astro';
import { tools, canonical } from '../../config';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const fields = {
  'compound-interest':[{key:'principal',label:'Starting amount',value:1000,min:0,max:1e11},{key:'monthly',label:'Monthly contribution',value:100,min:0,max:1e10},{key:'rate',label:'Annual interest rate (%)',value:5,min:0,max:50,step:.1},{key:'years',label:'Number of years',value:10,min:.1,max:80,step:.5}],
  'monthly-investment':[{key:'monthly',label:'Monthly investment',value:200,min:0,max:1e10},{key:'rate',label:'Estimated annual return (%)',value:6,min:-20,max:50,step:.1},{key:'years',label:'Number of years',value:15,min:.1,max:80,step:.5}],
  'loan-payment':[{key:'principal',label:'Loan amount',value:20000,min:1,max:1e11},{key:'rate',label:'Annual interest rate (%)',value:7,min:0,max:50,step:.1},{key:'years',label:'Loan term (years)',value:5,min:.1,max:50,step:.5}],
  'savings-goal':[{key:'target',label:'Savings target',value:10000,min:1,max:1e11},{key:'principal',label:'Current savings',value:1000,min:0,max:1e11},{key:'rate',label:'Annual interest rate (%)',value:3,min:0,max:50,step:.1},{key:'years',label:'Years to reach goal',value:5,min:.1,max:80,step:.5}],
}[tool.slug];
const guide = {
 'compound-interest':{
   heading:'How this compound interest calculator works',
   paragraphs:[
     'This example assumes a fixed annual percentage rate divided into equal monthly compounding periods. Monthly contributions are deposited at the end of each month, and the initial balance earns interest for the full term.',
     'The future value equals the initial amount multiplied by (1 + monthly rate) raised to the number of months, plus the future value of each monthly deposit. At a 0% rate, the balance equals the starting amount plus all contributions.',
     'Try lowering the rate or shortening the time frame. A smaller estimate can show how sensitive the outcome is to your assumptions.'
   ],
   caveat:'This does not model variable market returns, inflation, fees, tax, or annual percentage yield (APY) conventions. Verify how your actual account compounds interest.',
 },
 'monthly-investment':{
   heading:'Understanding recurring investments',
   paragraphs:[
     'This calculator estimates the future value of equal monthly investments using a constant illustrative annual rate, compounded monthly. It assumes each contribution occurs at the end of the month.',
     'The reported growth is the estimated future value minus the amount you paid in. Negative assumed returns are allowed to illustrate downside scenarios.',
     'Compare several return assumptions rather than treating one number as an expected outcome. Real investments can fluctuate sharply and may lose value.'
   ],
   caveat:'Figures exclude investment fees, tax, inflation, bid-ask spreads, transaction costs, and sequence-of-returns risk.',
 },
 'loan-payment':{
   heading:'How the monthly loan payment is calculated',
   paragraphs:[
     'The estimate uses the standard fixed-rate amortization formula: monthly payment = principal × monthly rate / [1 − (1 + monthly rate)^(−number of months)]. If the interest rate is zero, payment equals principal divided by the number of months.',
     'The total interest is the sum of all equal payments minus the amount originally borrowed. Longer terms usually reduce the monthly payment but increase total interest at the same rate.',
     'Before accepting a loan, compare the lender’s actual APR, fees, repayment schedule, prepayment terms and total amount payable.'
   ],
   caveat:'This simplified model does not calculate upfront fees, variable rates, balloon payments, skipped payments or differences in local APR definitions.',
 },
 'savings-goal':{
   heading:'Calculating a monthly savings target',
   paragraphs:[
     'Start with a target, current balance, time horizon and assumed interest rate. The calculator first estimates what your existing savings could grow to, then works out the monthly end-of-month deposit needed to cover the difference.',
     'If the estimated growth of your current savings already exceeds the target, the required monthly contribution is shown as zero. You can lower the assumed rate to test a more conservative scenario.',
     'A useful savings target should also consider rising prices, your emergency cash buffer and any fees or taxes on returns.'
   ],
   caveat:'The model assumes a constant monthly-compounded rate and does not account for inflation, taxes, fees or unpredictable investment performance.',
 }
}[tool.slug];
const jsonLd = [
  {'@type':'WebApplication',name:tool.name,applicationCategory:'FinanceApplication',operatingSystem:'Any modern browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description:tool.description,url:canonical(`/tools/${tool.slug}/`),isAccessibleForFree:true},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:canonical('/')},{'@type':'ListItem',position:2,name:'Calculators',item:canonical('/tools/')},{'@type':'ListItem',position:3,name:tool.name,item:canonical(`/tools/${tool.slug}/`)}]},
];
---
<Base title={tool.name} path={`/tools/${tool.slug}/`} description={`${tool.description} Free online calculator with clear assumptions and no data upload.`} jsonLd={jsonLd}>
  <div class="container"><div class="breadcrumb"><a href="/">Home</a> / <a href="/tools/">Calculators</a> / {tool.name}</div>
    <header class="page-intro"><span class="eyebrow">Finance / Interactive tools</span><h1>{tool.name}</h1><p>{tool.description} Adjust the assumptions and explore the result. Nothing is sent to our servers.</p></header>
    <div class="calculator-layout"><section aria-label={tool.name}>
      <div class="form-card"><form data-calculator={tool.slug} novalidate><div class="form-grid"><div class="form-field"><label for="currency">Currency (display only)</label><select id="currency" name="currency"><option value="USD">USD ($)</option><option value="INR">INR (₹)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option><option value="CAD">CAD ($)</option><option value="AUD">AUD ($)</option></select></div>{fields.map(field=><div class="form-field"><label for={field.key}>{field.label}</label><input id={field.key} name={field.key} type="number" min={field.min} max={field.max} step={field.step || 1} value={field.value} required inputmode="decimal" /></div>)}</div><p class="calc-error" id="calc-error" role="alert" hidden></p><button class="button calc-submit" type="submit">Calculate result <span aria-hidden="true">↗</span></button></form><div id="calc-output" aria-live="polite" aria-atomic="true"></div></div>
      <p class="calculator-note"><strong>How to interpret this:</strong> Currency selection changes only the symbol and formatting, not any exchange rate. All growth calculations use a fixed-rate, end-of-month-contribution model; results are examples, not offers or forecasts.</p>
    </section></div>
    <div class="calculator-guide"><span class="eyebrow">Behind the calculation</span><h2>{guide.heading}</h2>{guide.paragraphs.map(text=><p>{text}</p>)}<p><strong>Important limitation:</strong> {guide.caveat}</p><h2>Related reading</h2><p><a class="text-link" href="/articles/compound-interest-explained/">Compound interest explained</a> · <a class="text-link" href="/articles/build-an-emergency-fund/">Building an emergency fund</a> · <a class="text-link" href="/financial-disclaimer/">Financial disclaimer</a></p><a class="editorial-link" href="/tools/">All calculators <span aria-hidden="true">↗</span></a></div>
  </div>
  <script src="/js/calculators.js" defer></script>
</Base>
