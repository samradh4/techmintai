---
import Base from '../../layouts/Base.astro';
import {tools} from '../../config';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const fields = {
  'compound-interest':[{key:'principal',label:'Starting amount',value:1000,min:0,max:1e11},{key:'monthly',label:'Monthly contribution',value:100,min:0,max:1e10},{key:'rate',label:'Annual interest rate (%)',value:5,min:0,max:50,step:.1},{key:'years',label:'Number of years',value:10,min:.1,max:80,step:.5}],
  'monthly-investment':[{key:'monthly',label:'Monthly investment',value:200,min:0,max:1e10},{key:'rate',label:'Estimated annual return (%)',value:6,min:-20,max:50,step:.1},{key:'years',label:'Number of years',value:15,min:.1,max:80,step:.5}],
  'loan-payment':[{key:'principal',label:'Loan amount',value:20000,min:1,max:1e11},{key:'rate',label:'Annual interest rate (%)',value:7,min:0,max:50,step:.1},{key:'years',label:'Loan term (years)',value:5,min:.1,max:50,step:.5}],
  'savings-goal':[{key:'target',label:'Savings target',value:10000,min:1,max:1e11},{key:'principal',label:'Current savings',value:1000,min:0,max:1e11},{key:'rate',label:'Annual interest rate (%)',value:3,min:0,max:50,step:.1},{key:'years',label:'Years to reach goal',value:5,min:.1,max:80,step:.5}],
}[tool.slug];
const jsonLd={'@context':'https://schema.org','@type':'WebApplication',name:tool.name,applicationCategory:'FinanceApplication',operatingSystem:'Any modern web browser',offers:{'@type':'Offer',price:0,priceCurrency:'USD'},description:tool.description,url:`https://techmintai.com/tools/${tool.slug}/`};
---
<Base title={tool.name} path={`/tools/${tool.slug}/`} description={`${tool.description} Free calculator with no account or data upload.`} jsonLd={jsonLd}>
<div class="container"><div class="breadcrumb"><a href="/">Home</a> / <a href="/tools/">Tools</a> / {tool.name}</div><header class="page-intro"><span class="eyebrow">Interactive / Free tool</span><h1>{tool.name}</h1><p>{tool.description} Experiment with assumptions; estimates are not guarantees.</p></header><div class="form-card"><form data-calculator={tool.slug} novalidate><div class="form-grid"><div class="form-field"><label for="currency">Currency</label><select id="currency" name="currency"><option value="USD">USD ($)</option><option value="INR">INR (₹)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></div>{fields.map(field=><div class="form-field"><label for={field.key}>{field.label}</label><input id={field.key} name={field.key} type="number" min={field.min} max={field.max} step={field.step || 1} value={field.value} required inputmode="decimal" /></div>)}</div><p id="calc-error" role="alert" hidden style="color:#b42318"></p><button class="button" type="submit" style="margin-top:23px">Calculate →</button></form><div id="calc-output" aria-live="polite" aria-atomic="true"></div></div><p class="calculator-note">Note: Growth calculations assume a constant annual rate and end-of-month contributions with monthly compounding, except where otherwise stated. They ignore taxes, fees and inflation. Loan calculations assume fixed payments and a constant rate. Actual offers and investment returns vary.</p><p style="margin:24px 0 70px"><a class="text-link" href="/tools/">← Browse all calculators</a></p></div>
<script>import '../../scripts/calculators.js';</script>
</Base>
