---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {articles, relatedTo, type Article} from '../../data/articles';
import { categories,canonical } from '../../config';
export function getStaticPaths(){return articles.map((article)=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props as {article:Article};
const cat=categories.find(c=>c.slug===article.category)!;
const url=canonical(`/articles/${article.slug}/`);
const jsonLd={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.excerpt,datePublished:article.date,mainEntityOfPage:url,author:{'@type':'Organization',name:'TechMintAI Editorial Team'},publisher:{'@type':'Organization',name:'TechMintAI',logo:{'@type':'ImageObject',url:canonical('/techmintai-logo.webp')}},image:canonical('/og-default.png'),articleSection:cat.name,isAccessibleForFree:true};
---
<Base title={article.title} description={article.excerpt} path={`/articles/${article.slug}/`} type="article" articleDate={article.date} category={cat.name} jsonLd={jsonLd}>
  <div class="container"><div class="breadcrumb"><a href="/">Home</a> / <a href={`/category/${cat.slug}/`}>{cat.name}</a> / Article</div><div class="reading-layout" style="padding-top:27px"><article><header class="article-hero"><span class="pill">{cat.name}</span><h1>{article.title}</h1><p class="deck">{article.excerpt}</p><div class="byline">By TechMintAI Editorial Team · Published <time datetime={article.date}>{new Date(`${article.date}T12:00:00Z`).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time> · {article.readingMinutes} min read</div></header>
  <div class="article-prose"><section class="key-points" aria-label="Key takeaways"><h2>In short</h2><ul>{article.takeaways.map(point=><li>{point}</li>)}</ul></section>
  {article.blocks.map(block=><section><h2>{block.heading}</h2>{block.paragraphs.map(p=><p>{p}</p>)}{block.bullets && <ul>{block.bullets.map(item=><li>{item}</li>)}</ul>}</section>)}
  <h2>Further reading and sources</h2><p>These institutions provide helpful background material. Links are supplied for reader verification; inclusion does not imply endorsement.</p><ul class="source-list">{article.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>
  <p>Explore related guides in <a class="text-link" href={`/category/${cat.slug}/`}>{cat.name}</a>, compare estimates using our <a class="text-link" href="/tools/">free calculators</a>, and learn how we check and update articles in the <a class="text-link" href="/editorial-policy/">editorial policy</a>.</p>
  <div class="disclaimer-note">TechMintAI publishes general educational information. This article is not personalized financial, investment, legal or cybersecurity advice. Always assess your circumstances and local rules.</div></div></article>
  <aside class="sidebar"><h2>Explore more</h2><p>Independent, plain-English guides to money and technology.</p>{relatedTo(article).map(a=><a href={`/articles/${a.slug}/`}>{a.title} →</a>)}<hr style="border:0;border-top:1px solid var(--line);margin:18px 0"/><a href="/tools/">Try the free tools →</a><a href="/affiliate-disclosure/">How this site earns money →</a></aside></div>
  </div>
  <section class="section alt"><div class="container"><div class="section-head"><div><div class="eyebrow">Keep exploring</div><h2>Related reading</h2></div></div><div class="card-grid">{relatedTo(article).map(a=><ArticleCard article={a}/>)}</div></div></section>
</Base>
