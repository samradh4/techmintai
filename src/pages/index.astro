---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';
import { tools } from '../config';

const lead = articles.find(a => a.slug === 'compound-interest-explained')!;
const highlights = ['build-an-emergency-fund','etfs-vs-mutual-funds','recognize-digital-payment-scams']
  .map(slug => articles.find(a => a.slug === slug)!);
const feed = articles.filter(a => a.slug !== lead.slug).slice(0,6);

// Fixed-rate *illustration*, not market data. Monthly contributions at the end of each month.
const projection = (years: number) => {
  const months = years * 12;
  const monthlyRate = .05 / 12;
  return 1000 * Math.pow(1 + monthlyRate, months) + 100 * (Math.pow(1 + monthlyRate, months) - 1) / monthlyRate;
};
const x = (year: number) => 44 + (year / 20) * 466;
const y = (value: number) => 251 - value / 48000 * 206;
const growthPath = Array.from({length:21},(_,yr) => `${yr === 0 ? 'M' : 'L'}${x(yr).toFixed(1)} ${y(projection(yr)).toFixed(1)}`).join(' ');
const savingsPath = Array.from({length:21},(_,yr) => `${yr === 0 ? 'M' : 'L'}${x(yr).toFixed(1)} ${y(1000 + 100 * 12 * yr).toFixed(1)}`).join(' ');
---
<Base path="/" description="TechMintAI publishes practical personal finance and investing explainers, fintech and technology guides, plus free financial calculators.">
  <div class="container">
    <div class="edition-line"><span class="eyebrow">The TechMintAI Journal</span><span>Personal finance / Investing / Technology</span></div>
    <section class="lead-grid" aria-labelledby="frontpage-title">
      <article class="lead-story">
        <div class="story-meta"><span class="eyebrow">The big guide</span><span class="story-separator"></span><a href="/category/finance/">Personal Finance</a></div>
        <h1 id="frontpage-title"><a href={`/articles/${lead.slug}/`}>The quiet power of <em>compound interest.</em></a></h1>
        <p class="lead-deck">Saving doesn't need to be complicated. Learn how regular contributions, time and assumptions influence what your money could become.</p>
        <div class="lead-actions"><a class="editorial-link" href={`/articles/${lead.slug}/`}>Read the full guide <span aria-hidden="true">↗</span></a><span>{lead.readingMinutes} min read · Educational guide</span></div>
        <figure class="chart-feature" aria-labelledby="chart-title chart-caption">
          <div class="chart-heading"><div><span class="eyebrow">An illustrative example</span><h2 id="chart-title">What consistency can add up to</h2></div><span class="chart-unit">USD</span></div>
          <svg viewBox="0 0 552 300" role="img" aria-label="Line chart showing an illustrative deposit of $1,000 plus $100 monthly over 20 years at 5% annual interest, compared with contributions alone.">
            <g class="gridlines"><line x1="44" y1={y(0)} x2="510" y2={y(0)}/><line x1="44" y1={y(20000)} x2="510" y2={y(20000)}/><line x1="44" y1={y(40000)} x2="510" y2={y(40000)}/></g>
            <g class="chart-labels"><text x="1" y={y(0)+4}>$0</text><text x="1" y={y(20000)+4}>$20k</text><text x="1" y={y(40000)+4}>$40k</text><text x="43" y="273">0</text><text x={x(10)-7} y="273">10y</text><text x={x(20)-12} y="273">20y</text></g>
            <path d={savingsPath} class="chart-contributions"/><path d={growthPath} class="chart-growth"/>
            <circle cx={x(20)} cy={y(projection(20))} r="4.5" fill="#156c57" stroke="#fff" stroke-width="2"/>
          </svg>
          <figcaption id="chart-caption"><span class="chart-legend"><span class="legend-green"></span>Balance at hypothetical 5% fixed rate</span><span class="chart-legend"><span class="legend-gray"></span>Contributions only</span><small>$1,000 initial + $100/month. No fees, taxes or inflation. This is not a forecast.</small></figcaption>
        </figure>
      </article>
      <aside class="front-page-aside" aria-label="Featured reading">
        <div class="aside-title"><span class="eyebrow">Worth a closer look</span><span>01 — 03</span></div>
        {highlights.map((article, index) => <article class="aside-story"><div class="aside-number">0{index+1}</div><div><div class="meta"><span>{article.category === 'finance' ? 'PERSONAL FINANCE' : article.category.toUpperCase()}</span><span>{article.readingMinutes} MIN</span></div><h2><a href={`/articles/${article.slug}/`}>{article.title}</a></h2><p>{article.excerpt}</p></div></article>)}
        <a class="aside-bottom" href="/guides/">Browse the complete library <span aria-hidden="true">↗</span></a>
      </aside>
    </section>
  </div>

  <div class="section-directory"><div class="container directory-inner"><span class="directory-label">Explore a subject</span><nav aria-label="Browse categories"><a href="/category/finance/">Money</a><a href="/category/investing/">Investing</a><a href="/category/fintech/">Fintech</a><a href="/category/ai/">Artificial intelligence</a><a href="/category/technology/">Security & tech</a><a href="/category/software/">Software</a></nav></div></div>

  <section class="section" aria-labelledby="library-title"><div class="container"><div class="section-head"><div><span class="eyebrow">The reading list</span><h2 id="library-title">Guides to think with.</h2></div><p>Our starting collection focuses on the decisions, risks and everyday questions behind money and technology.</p></div><div class="card-grid">{feed.map(article => <ArticleCard article={article}/>)}</div><div class="section-link"><a href="/guides/" class="editorial-link">Explore every article <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="tools-section" aria-labelledby="tools-title"><div class="container tools-section-layout"><div class="tools-intro"><span class="eyebrow">Practical tools / free to use</span><h2 id="tools-title">Run the numbers.<br/><em>Then decide.</em></h2><p>These simple calculators let you test assumptions without handing over your personal financial information. Your inputs stay in your browser.</p><a class="editorial-link" href="/tools/">Visit all calculators <span aria-hidden="true">↗</span></a></div><div class="tools-table">{tools.map((tool,index) => <a href={`/tools/${tool.slug}/`} class="tools-table-row"><span class="tool-index">0{index+1}</span><span><strong>{tool.name}</strong><small>{tool.description}</small></span><span class="table-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>

  <section class="section" aria-labelledby="standards-title"><div class="container standards-layout"><div><span class="eyebrow">Behind the publication</span><h2 id="standards-title">Good financial information has to show its working.</h2></div><div class="standards-copy"><p>We explain assumptions, link to relevant primary resources and distinguish educational examples from personal recommendations. Financial information deserves more than a confident headline.</p><div class="standards-links"><a href="/editorial-policy/">Our editorial standards ↗</a><a href="/affiliate-disclosure/">How TechMintAI may earn money ↗</a><a href="/about/">About the publication ↗</a></div></div></div></section>
</Base>
