---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {articles} from '../data/articles';
import {tools} from '../config';
const featured = articles.find(a=>a.slug==='ai-budgeting-apps-guide')!;
---
<Base path="/" jsonLd={{'@context':'https://schema.org','@graph':[{'@type':'WebSite',name:'TechMintAI',url:'https://techmintai.com/',description:'Clear guides to finance, artificial intelligence and technology',potentialAction:{'@type':'SearchAction',target:'https://techmintai.com/search/?q={search_term_string}','query-input':'required name=search_term_string'}},{'@type':'Organization',name:'TechMintAI',url:'https://techmintai.com/',logo:'https://techmintai.com/techmintai-logo.webp'}]}}>
  <div class="container hero">
    <div><span class="pill">Finance × AI × Technology</span><h1>Make smarter moves with <span>money & tech.</span></h1><p class="lead">Clear, practical guides and free tools to help you understand the digital world and make more informed decisions. No unnecessary jargon.</p><div class="actions"><a class="button" href="/category/finance/">Explore articles →</a><a class="button secondary" href="/tools/">Free calculators</a></div><div class="trust-row"><span>✓ Independent explanations</span><span>✓ Free calculators</span><span>✓ Sources & transparent disclosures</span></div></div>
    <article class="hero-feature"><div class="feature-top"><span>Featured / AI + Money</span><span>7 min read</span></div><a href={`/articles/${featured.slug}/`} class="feature-visual" aria-label={`Read ${featured.title}`}><small>THE PRACTICAL GUIDE</small><b>AI + $</b></a><div class="feature-copy"><h2><a href={`/articles/${featured.slug}/`}>{featured.title}</a></h2><p>{featured.excerpt}</p><a class="text-link" href={`/articles/${featured.slug}/`}>Read the guide →</a></div></article>
  </div>
  <div class="topic-band"><div class="container topics"><a class="topic" href="/category/finance/"><strong>Finance ↗</strong><small>Smarter everyday money decisions</small></a><a class="topic" href="/category/ai/"><strong>Artificial Intelligence ↗</strong><small>AI explained without the hype</small></a><a class="topic" href="/category/fintech/"><strong>Fintech ↗</strong><small>Digital money, clearly explained</small></a><a class="topic" href="/category/technology/"><strong>Technology ↗</strong><small>Security and modern tools</small></a></div></div>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">The latest guides</div><h2>Fresh from TechMintAI</h2></div><p>Useful ideas and practical explainers, built around the questions people actually ask.</p></div><div class="card-grid">{articles.slice(0,6).map(article=><ArticleCard article={article} />)}</div><p style="margin-top:24px"><a class="text-link" href="/search/">Browse all articles →</a></p></div></section>
  <section class="section alt"><div class="container"><div class="section-head"><div><div class="eyebrow">Free tools</div><h2>Calculate before you decide.</h2></div><p>Simple, private calculators. Everything runs in your browser; no account required.</p></div><div class="tool-grid">{tools.map(tool=><a class="tool-card" href={`/tools/${tool.slug}/`}><span class="tool-symbol" aria-hidden="true">{tool.emoji}</span><h3>{tool.name}</h3><p>{tool.description}</p></a>)}</div></div></section>
  <section class="section"><div class="container"><div class="callout-strip"><div><h2>Better decisions start with better questions.</h2><p>Learn what matters, check the assumptions, and compare your options.</p></div><a class="button" href="/about/">How we work →</a></div></div></section>
</Base>
