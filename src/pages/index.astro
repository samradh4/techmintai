---
import Base from '../layouts/Base.astro';
import { articles } from '../data/articles';
import { tools } from '../config';
import '../styles/home.css';

const find = (slug: string) => articles.find(a => a.slug === slug)!;
const lead = find('compound-interest-explained');
const quickReads = [
  find('build-an-emergency-fund'),
  find('etfs-vs-mutual-funds'),
  find('recognize-digital-payment-scams'),
];
const stories = [
  find('zero-based-budget-guide'),
  find('investment-fees-compound-over-time'),
  find('apr-vs-apy-explained'),
];
const moreGuides = [
  find('ai-budgeting-apps-guide'),
  find('password-managers-and-passkeys'),
  find('ai-agents-vs-chatbots'),
  find('automate-small-business-workflows'),
];
const categoryLabel: Record<string,string> = {
  finance: 'Personal Finance', investing: 'Investing', fintech: 'Fintech',
  ai: 'Artificial Intelligence', technology: 'Technology', software: 'Software'
};
// Illustrative fixed assumptions, not a live rate, prediction or investment guarantee.
// Contributions happen at the end of each month.
const value = (years: number) => {
  const months = years * 12;
  const monthlyRate = 0.05 / 12;
  return 1000 * Math.pow(1 + monthlyRate, months) + 100 * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate);
};
const x = (year: number) => 50 + (year / 20) * 470;
const y = (amount: number) => 235 - (amount / 48000) * 178;
const growth = Array.from({length:21},(_,year) => `${year===0?'M':'L'}${x(year).toFixed(1)} ${y(value(year)).toFixed(1)}`).join(' ');
const deposits = Array.from({length:21},(_,year) => `${year===0?'M':'L'}${x(year).toFixed(1)} ${y(1000+100*12*year).toFixed(1)}`).join(' ');
const finalValue = value(20);
---
<Base path="/" description="Independent personal finance, investing and financial technology guides. Understand the numbers, compare your options and use free financial calculators.">
  <div class="container">
    <div class="home-edition" aria-label="Publication introduction">
      <div class="edition-kicker"><span class="edition-symbol" aria-hidden="true">✳</span><span>The TechMintAI Journal <span class="kicker-divider">/</span> The money issue</span></div>
      <div class="edition-explainer">A clearer perspective on money, investing & the technology around it.</div>
    </div>
  </div>

  <div class="container cover-container">
    <section class="cover-story" aria-labelledby="cover-heading">
      <div class="cover-copy">
        <div class="cover-topline"><span class="cover-marker"></span><span>THE BIG PICTURE</span><span class="cover-issue">01 / PERSONAL FINANCE</span></div>
        <h1 id="cover-heading">Make your money <em>work with time.</em></h1>
        <p>A clear example shows how time, small contributions and assumptions can shape the outcome of a long-term savings plan.</p>
        <a class="cover-cta" href={`/articles/${lead.slug}/`}>Read the full story <span aria-hidden="true">↗</span></a>
        <div class="cover-byline"><span>THE EXPLAINER SERIES</span><span>07 MIN READ</span><span>EDUCATIONAL, NOT ADVICE</span></div>
      </div>
      <div class="cover-visual">
        <div class="visual-head"><span>FIGURE 001 <span class="visual-divider">—</span> COMPOUNDING, VISUALIZED</span><span>20 YEARS</span></div>
        <div class="visual-number"><span>$</span>{(finalValue/1000).toFixed(1)}<span>k</span><small>Illustrative ending balance</small></div>
        <svg class="cover-chart" viewBox="0 0 565 277" role="img" aria-labelledby="cover-chart-title cover-chart-desc">
          <title id="cover-chart-title">Illustrative savings growth at a fixed annual return</title>
          <desc id="cover-chart-desc">A hypothetical $1,000 initial deposit plus $100 each month for 20 years. A fixed annual 5% rate compounded monthly grows to about $43,816, compared with $25,000 deposited. Excludes fees, tax and inflation and is not a prediction.</desc>
          <defs><linearGradient id="cover-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#226f56" stop-opacity=".22"/><stop offset="1" stop-color="#226f56" stop-opacity="0"/></linearGradient></defs>
          <g class="cover-chart-grid"><line x1="50" x2="520" y1={y(40000)} y2={y(40000)}/><line x1="50" x2="520" y1={y(20000)} y2={y(20000)}/><line x1="50" x2="520" y1={y(0)} y2={y(0)}/></g>
          <g class="cover-chart-labels"><text x="4" y={y(40000)+4}>$40k</text><text x="4" y={y(20000)+4}>$20k</text><text x="25" y={y(0)+4}>$0</text><text x="50" y="266">YEAR 0</text><text x="272" y="266">10</text><text x="487" y="266">20</text></g>
          <path d={`${growth} L${x(20)} ${y(0)} L${x(0)} ${y(0)} Z`} fill="url(#cover-fill)" />
          <path d={deposits} stroke="#889d91" stroke-width="2.5" stroke-dasharray="5 6" fill="none"/>
          <path d={growth} stroke="#166747" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <circle cx={x(20)} cy={y(finalValue)} r="6" fill="#166747" stroke="#e6ebdf" stroke-width="4"/>
        </svg>
        <div class="visual-legend"><span><i class="legend-line"></i> Hypothetical balance</span><span><i class="legend-dash"></i> Deposits only</span></div>
        <div class="visual-assumptions"><div><strong>$1,000</strong><span>Starting amount</span></div><div><strong>$100</strong><span>Added monthly</span></div><div><strong>5%</strong><span>Fixed annual rate*</span></div></div>
        <p class="visual-footnote">*Illustration only. No fees, taxes, inflation or variable returns. Not a forecast.</p>
      </div>
    </section>
  </div>

  <section class="now-reading-section" aria-labelledby="now-reading-title">
    <div class="container">
      <div class="section-label-line"><span class="eyebrow" id="now-reading-title">ON THE READING DESK</span><span class="section-count">THREE ESSENTIAL STARTING POINTS</span></div>
      <div class="now-reading-grid">
        {quickReads.map((article, index) => (
          <a class="now-reading-card" href={`/articles/${article.slug}/`}>
            <span class="reading-index">0{index + 1}</span>
            <span class="reading-content"><span class="reading-topic">{categoryLabel[article.category]} <span class="topic-dot">·</span> {article.readingMinutes} min read</span><strong>{article.title}</strong><span class="reading-desc">{article.excerpt}</span><span class="reading-arrow" aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="topic-strip"><div class="container topic-strip-inner"><span>FIND YOUR NEXT READ</span><nav aria-label="Browse subjects"><a href="/category/finance/">Money</a><a href="/category/investing/">Investing</a><a href="/category/fintech/">Fintech</a><a href="/category/ai/">Artificial intelligence</a><a href="/category/technology/">Digital security</a><a href="/category/software/">Software</a></nav></div></div>

  <section class="features-section" aria-labelledby="features-heading">
    <div class="container">
      <div class="feature-section-head"><div><span class="eyebrow">THE EDITOR'S NOTEBOOK</span><h2 id="features-heading">The details that <em>change the decision.</em></h2></div><p>Clear explanations of the little things that have a real impact on everyday financial decisions.</p></div>
      <div class="feature-grid">
        <a class="illustrated-feature budget-feature" href={`/articles/${stories[0].slug}/`}>
          <div class="feature-art feature-art-budget" aria-hidden="true">
            <div class="budget-art-label">YOUR MONEY, A CLEARER PLAN</div>
            <div class="budget-art-rows"><span><i></i>Needs<b></b></span><span><i></i>Goals<b></b></span><span><i></i>Everything else<b></b></span></div>
            <div class="budget-art-stamp">01 / BUDGETING</div>
          </div>
          <div class="feature-content"><span class="feature-meta">PERSONAL FINANCE <span>·</span> 8 MIN</span><h3>Give every dollar a job. Keep every decision in view.</h3><p>{stories[0].excerpt}</p><span class="feature-read">Read the guide <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="illustrated-feature fees-feature" href={`/articles/${stories[1].slug}/`}>
          <div class="feature-art feature-art-fees" aria-hidden="true">
            <span class="fees-art-title">A SMALL FEE <br /> ISN'T ALWAYS SMALL.</span>
            <div class="fees-bars"><div><i></i><span>FEES</span></div><div><i></i><span>TIME</span></div></div>
            <div class="fees-art-foot">THE LONG-TERM COST OF INVESTING</div>
          </div>
          <div class="feature-content"><span class="feature-meta">INVESTING <span>·</span> 9 MIN</span><h3>The small investing fee that deserves a second look.</h3><p>{stories[1].excerpt}</p><span class="feature-read">Read the guide <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="illustrated-feature rates-feature" href={`/articles/${stories[2].slug}/`}>
          <div class="feature-art feature-art-rates" aria-hidden="true"><div class="rates-topline">NOMINAL INTEREST VS. EFFECTIVE YIELD</div><div class="rates-big">5.00<span>%</span><span class="rates-arrow">→</span>5.12<span>%</span></div><div class="rates-bottom">ILLUSTRATION: 5% NOMINAL, COMPOUNDED MONTHLY</div></div>
          <div class="feature-content"><span class="feature-meta">PERSONAL FINANCE <span>·</span> 8 MIN</span><h3>APR, APY and the difference between two rates.</h3><p>{stories[2].excerpt}</p><span class="feature-read">Read the guide <span aria-hidden="true">↗</span></span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="tool-spotlight" aria-labelledby="tools-heading">
    <div class="container tool-spotlight-grid">
      <div class="tool-spotlight-lead"><span class="tool-eyebrow"><span class="tool-status"></span> THE TOOLKIT / 004</span><h2 id="tools-heading">Less guessing.<br/><em>More clarity.</em></h2><p>Make the assumptions yours. Explore payment plans, savings goals and long-term growth with free calculators that run in your browser.</p><a href="/tools/" class="light-button">Explore the toolkit <span aria-hidden="true">↗</span></a><span class="tool-privacy">NO ACCOUNT REQUIRED <span>•</span> INPUTS STAY ON YOUR DEVICE</span></div>
      <div class="tool-spotlight-entries">{tools.map((tool,index)=>(<a href={`/tools/${tool.slug}/`} class="tool-spotlight-entry"><span class="tool-number">0{index+1}</span><span><strong>{tool.name}</strong><small>{tool.description}</small></span><span class="tool-entry-arrow" aria-hidden="true">↗</span></a>))}</div>
    </div>
  </section>

  <section class="latest-section" aria-labelledby="latest-heading">
    <div class="container"><div class="latest-heading-row"><div><span class="eyebrow">THE READING ROOM</span><h2 id="latest-heading">Go a little <em>deeper.</em></h2></div><a href="/guides/" class="latest-browse">View all guides <span aria-hidden="true">↗</span></a></div><div class="latest-grid">
      {moreGuides.map((article,index)=>(<a href={`/articles/${article.slug}/`} class="latest-item"><span class="latest-item-index">0{index+1} / {categoryLabel[article.category]}</span><h3>{article.title}</h3><p>{article.excerpt}</p><span class="latest-more">{article.readingMinutes} MIN READ <span aria-hidden="true">↗</span></span></a>))}
    </div></div>
  </section>

  <section class="publisher-promise"><div class="container publisher-grid"><div><span class="eyebrow">WHY WE PUBLISH</span><h2>In finance, being clear matters more than being loud.</h2></div><div><p>We explain our assumptions, link to primary resources where practical, and keep educational guidance separate from individualized recommendations. We’d rather show the working than promise a shortcut.</p><div class="publisher-links"><a href="/editorial-policy/">Editorial standards ↗</a><a href="/affiliate-disclosure/">How we earn ↗</a><a href="/about/">About TechMintAI ↗</a></div></div></div></section>
</Base>
